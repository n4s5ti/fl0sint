                    "startLine": 9,
                    "endLine": 53,
                    "content": "class MockEnricher(Enricher):     \"\"\"Mock enricher for testing.\"\"\"     InputType = str     OutputType = str     @classmethod     def name(cls) -> str:         return \"mock_enricher\"     @classmethod     def category(cls) -> str:         return \"Test\"     @classmethod     def key(cls) -> str:         return \"test_key\"     @classmethod     def get_params_schema(cls) -> List[Dict[str, Any]]:         return [             {                 \"name\": \"TEST_API_KEY\",                 \"type\": \"vaultSecret\",                 \"description\": \"Test API key\",                 \"required\": True,             },             {                 \"name\": \"OPTIONAL_KEY\",                 \"type\": \"vaultSecret\",                 \"description\": \"Optional key\",                 \"required\": False,                 \"default\": \"default_value\",             },             {                 \"name\": \"NON_VAULT_PARAM\",                 \"type\": \"string\",                 \"description\": \"Non-vault parameter\",                 \"required\": False,                 \"default\": \"test\",             },         ]     async def scan(self, data: List[InputType]) -> List[OutputType]:         return data"
