                    "content": "    def documentation(cls) -> str:         \"\"\"         Return formatted markdown documentation for this enricher.         Override this method to provide custom documentation.         Falls back to cleaned docstring if not overridden.         \"\"\"         import inspect         return inspect.cleandoc(cls.__doc__ or \"No documentation available.\")"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_core/core/enricher_base.py:Enricher.input_schema#0",
                    "name": "input_schema",
