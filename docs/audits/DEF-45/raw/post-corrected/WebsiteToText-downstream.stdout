            "filePath": "flowsint-core/src/flowsint_core/core/logger.py",
            "nodeType": "Method",
            "startLine": 243,
            "endLine": 245,
            "content": "    def error(self, sketch_id: Union[str, UUID], message: Dict) -> None:         \"\"\"Log an error message.\"\"\"         self._log(sketch_id, EventLevel.FAILED, message)"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_core/core/logger.py:LoggerSingleton.warn#2",
            "name": "warn",
            "filePath": "flowsint-core/src/flowsint_core/core/logger.py",
            "nodeType": "Method",
            "startLine": 247,
            "endLine": 249,
            "content": "    def warn(self, sketch_id: Union[str, UUID], message: Dict) -> None:         \"\"\"Log a warning message.\"\"\"         self._log(sketch_id, EventLevel.WARNING, message)"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_core/core/logger.py:LoggerSingleton.completed#2",
            "name": "completed",
            "filePath": "flowsint-core/src/flowsint_core/core/logger.py",
            "nodeType": "Method",
            "startLine": 259,
            "endLine": 276,
            "content": "    def completed(self, sketch_id: Union[str, UUID], message: Dict) -> None:         \"\"\"Log a completed message.\"\"\"         self._log(sketch_id, EventLevel.COMPLETED, message)         # Also publish to status channel for graph refresh         try:             import uuid             temp_log_id = str(uuid.uuid4())             from ..tasks.event import emit_status_event_task             emit_status_event_task.apply(                 args=[temp_log_id, str(sketch_id), EventLevel.COMPLETED, message]             )         except Exception as e:             import logging             logging.error(f\"Failed to emit status event: {e}\")"
        },
        {
            "id": "Method:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:WebsiteToText.__init__",
            "name": "__init__",
            "filePath": "flowsint-enrichers/src/flowsint_enrichers/website/to_text.py",
            "nodeType": "Method",
            "startLine": 128,
            "endLine": 134,
            "content": "    def __init__(self, *args, artifact_store: FilesystemArtifactStore | None = None,                  retention_authority: RetentionAuthority | None = None,                  runtime_config: str | PathLike[str] | None = None, **kwargs):         super().__init__(*args, **kwargs)         self._artifact_store = artifact_store         self._retention_authority = retention_authority         self._runtime_config = runtime_config"
        },
        {
