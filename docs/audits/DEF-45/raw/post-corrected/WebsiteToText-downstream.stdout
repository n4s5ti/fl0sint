                    "filePath": "flowsint-enrichers/src/flowsint_enrichers/website/to_text.py",
                    "nodeType": "Function",
                    "startLine": 58,
                    "endLine": 66,
                    "content": "def _origin(url: str) -> str:     parts = urlsplit(url)     parsed_port = parts.port     port = parsed_port if parsed_port is not None else (443 if parts.scheme == \"https\" else 80)     if port == 0:         raise ValueError(\"invalid URL port\")     host = parts.hostname or \"\"     host = f\"[{host.lower()}]\" if \":\" in host else host.lower()     return f\"{parts.scheme}://{host}:{port}\""
                },
                {
                    "id": "Function:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:_digest",
                    "name": "_digest",
                    "filePath": "flowsint-enrichers/src/flowsint_enrichers/website/to_text.py",
                    "nodeType": "Function",
                    "startLine": 69,
                    "endLine": 72,
                    "content": "def _digest(value: object) -> str:     return hashlib.sha256(         json.dumps(value, sort_keys=True, separators=(\",\", \":\")).encode()     ).hexdigest()"
                },
