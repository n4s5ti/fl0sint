                    "name": "detect",
                    "filePath": "flowsint-types/src/flowsint_types/website.py",
                    "nodeType": "Method",
                    "startLine": 58,
                    "endLine": 66,
                    "content": "    def detect(cls, line: str) -> bool:         \"\"\"Detect if a line of text contains a website URL.\"\"\"         line = line.strip()         if not line:             return False         # URL pattern: must start with http:// or https://         url_pattern = r\"^https?://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(/.*)?$\"         return bool(re.match(url_pattern, line))"
                }
