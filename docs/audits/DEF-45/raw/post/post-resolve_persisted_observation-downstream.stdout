                    "nodeType": "Function",
                    "startLine": 599,
                    "endLine": 605,
                    "content": "def _byte_map(source: str) -> list[int]:     offsets = [0]     total = 0     for character in source:         total += len(character.encode(\"utf-8\"))         offsets.append(total)     return offsets"
                },
                {
                    "id": "Function:flowsint-core/src/flowsint_execution/observed_extraction.py:_observation_id",
                    "name": "_observation_id",
                    "filePath": "flowsint-core/src/flowsint_execution/observed_extraction.py",
                    "nodeType": "Function",
                    "startLine": 608,
                    "endLine": 612,
                    "content": "def _observation_id(artifact: ArtifactReference, occurrence_id: str,                     kind: ObservationKind, span: RawSpan) -> str:     key = \"\\0\".join((artifact.snapshot_id, artifact.content_digest, occurrence_id,                      kind.value, str(span.start_byte), str(span.end_byte))).encode()     return \"observation-\" + hashlib.sha256(key).hexdigest()[:32]"
                },
