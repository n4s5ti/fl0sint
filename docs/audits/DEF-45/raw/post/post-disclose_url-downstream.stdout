        "filePath": "flowsint-core/src/flowsint_execution/url_policy.py",
        "nodeType": "Function",
        "startLine": 28,
        "endLine": 38,
        "content": "def disclose_url(url: str) -> str:     \"\"\"Return a report-safe URL, dropping an ambiguous credential-like query.\"\"\"     parts = urlsplit(url)     host = f\"[{parts.hostname}]\" if parts.hostname and \":\" in parts.hostname else parts.hostname     port = f\":{parts.port}\" if parts.port is not None else \"\"     try:         pairs = parse_qsl(parts.query, keep_blank_values=True, strict_parsing=False)         query = urlencode(pairs) if all(_query_name_supported(name) for name, _ in pairs) else \"\"     except (UnicodeError, ValueError):         query = \"\"     return urlunsplit((parts.scheme, f\"{host or ''}{port}\", parts.path or \"/\", query, \"\"))"
    },
