essage\": f\"No emails found for website {str(website.url)}\"},                     )                 elif not website_result[\"phones\"]:                     Logger.info(                         self.sketch_id,                         {\"message\": f\"No phones found for website {str(website.url)}\"},                     )                 results.append(website_result)             except Exception as e:                 # Log error but continue with other websites                 Logger.error(                     self.sketch_id,                     {\"message\": f\"Error crawling {str(website.url)}: {str(e)}\"},                 )                 # Add empty result for failed website                 results.append(                     {                         \"website\": str(                             website.url                         ),  # Store as string instead of Website object                         \"emails\": [],                         \"phones\": [],                     }                 )                 continue         return results     def postprocess(self, results: List[OutputT ... [truncated]"
