                    "nodeType": "Function",
                    "startLine": 35,
                    "endLine": 40,
                    "content": "def _origin(url: str) -> str:     parts = urlsplit(url)     port = parts.port if parts.port is not None else (443 if parts.scheme == \"https\" else 80)     host = parts.hostname or \"\"     host = f\"[{host.lower()}]\" if \":\" in host else host.lower()     return f\"{parts.scheme}://{host}:{port}\""
                },
