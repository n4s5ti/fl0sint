            "content": "def _diagnostic(     code: str, message: str, *, retryable: bool = False ) -> RedactedDiagnostic:     return RedactedDiagnostic(         code=code, safe_message=message[:512], retryable=retryable     )"
        },
        {
            "id": "Function:flowsint-core/src/flowsint_execution/fetch.py:execute_fetch",
