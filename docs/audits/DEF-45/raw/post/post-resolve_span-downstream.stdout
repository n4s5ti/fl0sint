                    "content": "    def _dir(fd: int, name: str) -> int:         return os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_execution/artifacts.py:FilesystemArtifactStore._read_bounded#2",
                    "name": "_read_bounded",
                    "filePath": "flowsint-core/src/flowsint_execution/artifacts.py",
                    "nodeType": "Method",
                    "startLine": 184,
                    "endLine": 194,
                    "content": "    def _read_bounded(fd: int, limit: int) -> bytes:         info = os.fstat(fd)         if not stat.S_ISREG(info.st_mode) or info.st_size > limit:             raise OSError(\"unsafe or oversized artifact file\")         chunks, remaining = [], info.st_size         while remaining:             chunk = os.read(fd, min(remaining, 1024 * 1024))             if not chunk: raise OSError(\"short artifact read\")             chunks.append(chunk); remaining -= len(chunk)         if os.read(fd, 1): raise OSError(\"artifact grew during read\")         return b\"\".join(chunks)"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_execution/artifacts.py:FilesystemArtifactStore.read#3",
                    "name": "read",
                    "filePath": "flowsint-core/src/flowsint_execution/artifacts.py",
                    "nodeType": "Method",
                    "startLine": 250,
                    "endLine": 271,
                    "content": "    def read(self, digest: str, snapshot_id: str, *, expected_length: int | None = None) -> tuple[bytes, dict[str, Any]]:         if not re.fullmatch(_DIGEST, digest) or not re.fullmatch(r\"[a-f0-9]{32}\", snapshot_id): raise FileNotFoundError         if expected_length is None or not 0 <= expected_length <= _MAX_ARTIFACT_BYTES: raise ValueError(\"invalid length\")         root_fd = self._root_fd()         try:             records_fd = self._dir(root_fd, \"records\")             try:                 fd = os.open(f\"{snapshot_id}.json\", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=records_fd)                 try: metadata = json.loads(self._read_bounded(fd, _MAX_METADATA_BYTES))                 finally: os.close(fd)             finally: os.close(records_fd)             objects_fd = self._dir(root_fd, \"objects\")             try:                 prefix_fd = self._dir(objects_fd, digest[:2])                 try:                     fd = os.open(f\"{digest}.body\", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=prefix_fd)                     try: body = self._read_bounded(fd, expected_length)                     finally: os.close(fd)                 finally: os.close(prefix_fd)             finally: os.close(objects_fd)             return body, metadata         finally: os.close(root_fd)"
                }
            ]
        }
    ],
