                    "nodeType": "Function",
                    "startLine": 135,
                    "endLine": 136,
                    "content": "def _aware(value: datetime) -> bool:     return value.tzinfo is not None and value.utcoffset() is not None"
                },
                {
                    "id": "Function:flowsint-core/src/flowsint_execution/artifacts.py:_bound",
                    "name": "_bound",
                    "filePath": "flowsint-core/src/flowsint_execution/artifacts.py",
                    "nodeType": "Function",
                    "startLine": 138,
                    "endLine": 148,
                    "content": "def _bound(context: ArtifactContext, decision: RetentionDecision, now: datetime) -> str | None:     if not _aware(now) or not _aware(decision.issued_at) or not _aware(decision.expires_at):         return \"malformed_policy_time\"     if now < decision.issued_at:         return \"policy_not_yet_valid\"     if now >= decision.expires_at:         return \"policy_expired\"     if (context.operation_id != decision.operation_id or context.caller_id != decision.caller_id             or context.scope != decision.scope or context.source_family != decision.source_family):         return \"authorization_mismatch\"     return None"
                },
                {
                    "id": "Function:flowsint-core/src/flowsint_execution/artifacts.py:_current_policy",
                    "name": "_current_policy",
                    "filePath": "flowsint-core/src/flowsint_execution/artifacts.py",
                    "nodeType": "Function",
                    "startLine": 150,
                    "endLine": 162,
                    "content": "def _current_policy(decision: RetentionDecision, authority: RetentionAuthority | None,                     now: datetime) -> tuple[ArtifactState, str] | None:     if authority is None:         return ArtifactState.HOLD, \"current_policy_unavailable\"     if not _aware(authority.expires_at):         return ArtifactState.REVIEW, \"malformed_current_policy\"     if now >= authority.expires_at:         return ArtifactState.REVIEW, \"current_policy_expired\"     fields = (\"issuer_id\", \"reviewer_id\", \"policy_id\", \"policy_digest\", \"caller_id\", \"scope\",               \"source_family\", \"expires_at\", \"retain_body\", \"retain_normalized_text\")     if any(getattr(decision, name) != getattr(authority, name) for name in fields):         return ArtifactState.REVIEW, \"current_policy_mismatch\"     return None"
                },
                {
