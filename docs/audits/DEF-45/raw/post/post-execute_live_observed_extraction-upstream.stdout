    "target": {
        "id": "Function:flowsint-core/src/flowsint_execution/extraction_runtime.py:execute_live_observed_extraction",
        "name": "execute_live_observed_extraction",
        "filePath": "flowsint-core/src/flowsint_execution/extraction_runtime.py",
