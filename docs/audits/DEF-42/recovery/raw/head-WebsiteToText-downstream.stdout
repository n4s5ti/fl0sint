                    "content": "    async def _structured_execution_context(self) -> AsyncIterator[Any]:         \"\"\"Provide optional shared resources for structured per-input processing.\"\"\"         yield None"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_core/core/enricher_base.py:Enricher._process_single_input_structured#2",
                    "name": "_process_single_input_structured",
