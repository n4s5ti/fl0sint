                    "content": "    def _outputs_from_text(self, text: str) -> tuple[Phrase, ...]:         \"\"\"Build the per-occurrence outputs without flattening their ownership.\"\"\"         return (Phrase(text=text),) if text else ()"
                },
                {
                    "id": "Method:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:WebsiteToText._diagnostic#2",
