                },
                {
                    "id": "Method:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:WebsiteToText._legacy_outputs#1",
                    "name": "_legacy_outputs",
                    "filePath": "flowsint-enrichers/src/flowsint_enrichers/website/to_text.py",
                    "nodeType": "Method",
                    "startLine": 225,
                    "endLine": 233,
                    "content": "    def _legacy_outputs(         occurrences: Sequence[WebsiteTextOccurrence],     ) -> List[OutputType]:         return [             output             for occurrence in occurrences             if occurrence.status is OutcomeStatus.SUCCESS             for output in occurrence.outputs         ]"
                },
                {
                    "id": "Method:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:WebsiteToText._postprocess_occurrences#1",
                    "name": "_postprocess_occurrences",
                    "filePath": "flowsint-enrichers/src/flowsint_enrichers/website/to_text.py",
                    "nodeType": "Method",
                    "startLine": 402,
                    "endLine": 422,
                    "content": "    def _postprocess_occurrences(         self, occurrences: Sequence[WebsiteTextOccurrence]     ) -> None:         if not self._graph_service:             return         for occurrence in occurrences:             if occurrence.status is not OutcomeStatus.SUCCESS:                 continue             self.create_node(occurrence.source)             for output in occurrence.outputs:                 if not output.text:                     continue                 self.create_node(output)                 self.create_relationship(                     occurrence.source, output, \"HAS_INNER_TEXT\"                 )                 self.log_graph_message(                     f\"Extracted text from {occurrence.source.url} \"                     f\"({len(output.text)} chars).\"                 )"
                },
                {
                    "id": "Function:flowsint-core/src/flowsint_core/core/enricher_base.py:build_params_model",
                    "name": "build_params_model",
                    "filePath": "flowsint-core/src/flowsint_core/core/enricher_base.py",
                    "nodeType": "Function",
                    "startLine": 29,
                    "endLine": 59,
                    "content": "def build_params_model(params_schema: list) -> BaseModel:     \"\"\"     Build a strict Pydantic model from a params_schema.     Unknown fields will raise a validation error.     Note: Vault secrets are always optional in the Pydantic model to allow     for deferred configuration. Required validation happens after vault resolution.     \"\"\"     fields: Dict[str, Any] = {}     for param in params_schema:         name = param[\"name\"]         param_type = param.get(\"type\", \"string\")         field_type = bool if param_type == \"bool\" else str         required = param.get(\"required\", False)         # Vault secrets are always optional in Pydantic validation         # Required validation happens after vault resolution         if param_type == \"vaultSecret\":             default = param.get(\"default\", None)         else:             default = ... if required else param.get(\"default\")         fields[name] = (             Optional[field_type],             Field(default=default, description=param.get(\"description\", \"\")),         )     model = create_model(\"ParamsModel\", __config__=ConfigDict(extra=\"forbid\"), **fields)     return model"
                }
            ]
        },
