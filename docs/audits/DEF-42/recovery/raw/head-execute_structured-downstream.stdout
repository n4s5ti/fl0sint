                    "content": "    def _input_validation_context(self) -> tuple[TypeAdapter | None, str | None]:         if self.InputType is NotImplemented:             return None, None         base_type = self.InputType         adapter = TypeAdapter(base_type)         primary_field = None         if issubclass(base_type, BaseModel):             for name, field in base_type.model_fields.items():                 if field.json_schema_extra and field.json_schema_extra.get(\"primary\"):                     primary_field = name                     break             if primary_field is None:                 for name, field in base_type.model_fields.items():                     if field.is_required():                         primary_field = name                         break                 if primary_field is None:                     primary_field = next(iter(base_type.model_fields.keys()))         return adapter, primary_field"
