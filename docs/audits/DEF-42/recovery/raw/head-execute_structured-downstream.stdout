                    "content": "    def log_graph_message(self, message: str) -> None:         \"\"\"         Log a graph operation message.         Args:             message: Message to log         \"\"\"         self._graph_service.log_graph_message(message)"
                },
                {
                    "id": "Method:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:WebsiteToText._outputs_from_text#1",
