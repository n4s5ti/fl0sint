                    "content": "    def name(cls) -> str:         return \"website_to_text\""
                },
                {
                    "id": "Method:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:WebsiteToText._outputs_from_text#1",
                    "name": "_outputs_from_text",
                    "filePath": "flowsint-enrichers/src/flowsint_enrichers/website/to_text.py",
