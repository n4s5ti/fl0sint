        "startLine": 85,
        "endLine": 103,
        "content": "class TrustedFetchPolicy(_Frozen):     \"\"\"Trusted local caller and destination authority, never request-controlled.\"\"\"     caller_id: str = Field(min_length=1, max_length=256, pattern=r\"^\\S+$\")     scope: str = Field(min_length=1, max_length=1024)     capability_digest: Digest     endpoint_policy_digest: Digest     allowed_origins: tuple[str, ...] = Field(min_length=1, max_length=256)     @model_validator(mode=\"after\")     def normalized_origins(self):         normalized = tuple(_origin(value) for value in self.allowed_origins)         if normalized != self.allowed_origins or len(set(normalized)) != len(             normalized         ):             raise ValueError(                 \"allowed origins must be unique canonical origins with effective ports\"             )         return self"
    },
