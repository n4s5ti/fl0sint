_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ 

db_path = PosixPath('/home/n4s5ti/.cache/omp/session-tmp/omp.bzVT2zWF/pytest-of-n4s5ti/pytest-41/test_alembic_head_bootstraps_e0/flowsint.db')

    def _upgrade_sqlite(db_path: Path) -> None:
        api_dir = Path(__file__).resolve().parents[1]
        repo_dir = api_dir.parent
        env = os.environ.copy()
        env["DATABASE_URL"] = f"sqlite:///{db_path}"
        package_paths = [
            repo_dir / "flowsint-core" / "src",
            repo_dir / "flowsint-types" / "src",
            repo_dir / "flowsint-enrichers" / "src",
        ]
        inherited_pythonpath = env.get("PYTHONPATH")
        env["PYTHONPATH"] = os.pathsep.join(
            [*(str(path) for path in package_paths)]
            + ([inherited_pythonpath] if inherited_pythonpath else [])
        )
        result = subprocess.run(
            [sys.executable, "-m", "alembic", "upgrade", "head"],
            cwd=api_dir,
            env=env,
            text=True,
            capture_output=True,
            timeout=60,
        )
    
