{
  "text": "__ARGV__=[\"pip3r\",\"doctor\",\"--help\"]\n__STDOUT__\nUSAGE\n  pip3r doctor [--cwd value] [--json] [--deep] [--meta] [--graph] [--repo value] [--lbug-path value] [--has] [--format-check] [--typecheck] [--lint] [--test] [--continue-on-error] [--strict] [--logs value]... [--hunt] [--hunt-baseline value] [--scope value]... [--hunt-seed] [--hunt-seed-apply] [--seed-profile value] [--seed-workspace value] [--hunt-seed-max value] [--investigate] [--verify-refactor value]\n  pip3r doctor --help\n\nRun repository verification scripts\n\nPIP3R_JSON_PROBE: {\"version\":1,\"bare\":false}\n\nFLAGS\n  -c [--cwd]                                   Target directory to verify\n     [--json]                                  Emit JSON summary instead of plain text                                                                                              [default = false]\n     [--deep]                                  Compatibility flag for deep verification mode                                                                                        [default = false]\n     [--meta]                                  Wrap JSON output in a MetaReport-style envelope                                                                                      [default = false]\n     [--graph/--no-graph]                      Run graph health check when a LadybugDB read model exists                                                                            [default = true]\n     [--repo]                                  GraphOS repo name to open\n     [--lbug-path]                             Path to the LadybugDB read model\n     [--has/--no-has]                          Run has against .hasrc when present (passing any check flag selects only those checks)\n     [--format-check/--no-format-check]        Run the format:check script when present (passing any check flag selects only those checks)\n     [--typecheck/--no-typecheck]              Run the typecheck script when present (passing