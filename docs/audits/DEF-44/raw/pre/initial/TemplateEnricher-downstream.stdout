                    "content": "    def graph_service(self) -> GraphService:         \"\"\"         Get the graph service instance.         Returns:             GraphService instance for advanced operations         \"\"\"         return self._graph_service"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_core/core/logger.py:LoggerSingleton.info#2",
                    "name": "info",
                    "filePath": "flowsint-core/src/flowsint_core/core/logger.py",
                    "nodeType": "Method",
                    "startLine": 239,
                    "endLine": 241,
                    "content": "    def info(self, sketch_id: Union[str, UUID], message: Dict) -> None:         \"\"\"Log an info message.\"\"\"         self._log(sketch_id, EventLevel.INFO, message)"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_core/core/logger.py:LoggerSingleton.error#2",
                    "name": "error",
                    "filePath": "flowsint-core/src/flowsint_core/core/logger.py",
                    "nodeType": "Method",
                    "startLine": 243,
                    "endLine": 245,
                    "content": "    def error(self, sketch_id: Union[str, UUID], message: Dict) -> None:         \"\"\"Log an error message.\"\"\"         self._log(sketch_id, EventLevel.FAILED, message)"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_core/core/logger.py:LoggerSingleton.completed#2",
                    "name": "completed",
                    "filePath": "flowsint-core/src/flowsint_core/core/logger.py",
                    "nodeType": "Method",
                    "startLine": 259,
                    "endLine": 276,
                    "content": "    def completed(self, sketch_id: Union[str, UUID], message: Dict) -> None:         \"\"\"Log a completed message.\"\"\"         self._log(sketch_id, EventLevel.COMPLETED, message)         # Also publish to status channel for graph refresh         try:             import uuid             temp_log_id = str(uuid.uuid4())             from ..tasks.event import emit_status_event_task             emit_status_event_task.apply(                 args=[temp_log_id, str(sketch_id), EventLevel.COMPLETED, message]             )         except Exception as e:             import logging             logging.error(f\"Failed to emit status event: {e}\")"
                },
                {
                    "id": "Function:flowsint-core/src/flowsint_core/core/enricher_base.py:build_params_model",
                    "name": "build_params_model",
                    "filePath": "flowsint-core/src/flowsint_core/core/enricher_base.py",
                    "nodeType": "Function",
                    "startLine": 29,
                    "endLine": 59,
                    "content": "def build_params_model(params_schema: list) -> BaseModel:     \"\"\"     Build a strict Pydantic model from a params_schema.     Unknown fields will raise a validation error.     Note: Vault secrets are always optional in the Pydantic model to allow     for deferred configuration. Required validation happens after vault resolution.     \"\"\"     fields: Dict[str, Any] = {}     for param in params_schema:         name = param[\"name\"]         param_type = param.get(\"type\", \"string\")         field_type = bool if param_type == \"bool\" else str         required = param.get(\"required\", False)         # Vault secrets are always optional in Pydantic validation         # Required validation happens after vault resolution         if param_type == \"vaultSecret\":             default = param.get(\"default\", None)         else:             default = ... if required else param.get(\"default\")         fields[name] = (             Optional[field_type],             Field(default=default, description=param.get(\"description\", \"\")),         )     model = create_model(\"ParamsModel\", __config__=ConfigDict(extra=\"forbid\"), **fields)     return model"
                },
                {
                    "id": "Function:flowsint-core/src/flowsint_execution/models.py:canonical_input_hash",
                    "name": "canonical_input_hash",
                    "filePath": "flowsint-core/src/flowsint_execution/models.py",
                    "nodeType": "Function",
                    "startLine": 139,
                    "endLine": 149,
                    "content": "def canonical_input_hash(value: Any) -> str:     \"\"\"Return the stable SHA-256 reference for an input without retaining it.\"\"\"     canonical = json.dumps(         _canonicalize_input(value),         ensure_ascii=False,         separators=(\",\", \":\"),         sort_keys=True,         allow_nan=False,     )     return hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()"
                }
            ]
