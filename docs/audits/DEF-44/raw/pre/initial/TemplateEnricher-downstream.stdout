                    "id": "Function:flowsint-core/src/flowsint_core/utils.py:resolve_type",
                    "name": "resolve_type",
                    "filePath": "flowsint-core/src/flowsint_core/utils.py",
                    "nodeType": "Function",
                    "startLine": 131,
                    "endLine": 159,
                    "content": "def resolve_type(details: dict, schema_context: dict = None) -> str:     if \"anyOf\" in details:         types = []         for option in details[\"anyOf\"]:             if \"$ref\" in option:                 ref = option[\"$ref\"].split(\"/\")[-1]                 types.append(ref)             elif option.get(\"type\") == \"array\":                 # Handle array types within anyOf                 item_type = resolve_type(option.get(\"items\", {}), schema_context)                 types.append(f\"{item_type}[]\")             else:                 types.append(option.get(\"type\", \"unknown\"))         return \" | \".join(types)     if \"type\" in details:         if details[\"type\"] == \"array\":             item_type = resolve_type(details.get(\"items\", {}), schema_context)             return f\"{item_type}[]\"         return details[\"type\"]     # Handle $ref in array items or other contexts     if \"$ref\" in details and schema_context:         ref_path = details[\"$ref\"]         if ref_path.startswith(\"#/$defs/\"):             ref_name = ref_path.split(\"/\")[-1]             return ref_name     return \"any\""
                }
            ]
        },
