            "filePath": "flowsint-core/src/flowsint_core/core/connector_egress.py",
            "count": 2,
            "symbols": [
                {
                    "id": "Function:flowsint-core/src/flowsint_core/core/connector_egress.py:connector_template_digest",
                    "name": "connector_template_digest",
                    "filePath": "flowsint-core/src/flowsint_core/core/connector_egress.py",
                    "nodeType": "Function",
                    "startLine": 277,
                    "endLine": 283,
                    "content": "def connector_template_digest(template: object) -> str:     \"\"\"Hash strict template content for worker replay without retaining it.\"\"\"     content = template.model_dump(mode=\"json\")     serialized = json.dumps(         content, ensure_ascii=False, separators=(\",\", \":\"), sort_keys=True     )     return hashlib.sha256(serialized.encode(\"utf-8\")).hexdigest()"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_core/core/connector_egress.py:EgressAuthorizer.enrichment#0",
                    "name": "enrichment",
                    "filePath": "flowsint-core/src/flowsint_core/core/connector_egress.py",
                    "nodeType": "Method",
                    "startLine": 182,
                    "endLine": 183,
                    "content": "    def enrichment(cls) -> EgressAuthorizer:         return cls(allowed_capabilities=frozenset({\"enrich.read\"}))"
                }
            ]
        },
        {
            "filePath": "flowsint-core/src/flowsint_core/core/projection/contracts.py",
            "count": 2,
            "symbols": [
                {
                    "id": "Function:flowsint-core/src/flowsint_core/core/projection/contracts.py:digest_snapshot",
                    "name": "digest_snapshot",
                    "filePath": "flowsint-core/src/flowsint_core/core/projection/contracts.py",
                    "nodeType": "Function",
                    "startLine": 268,
                    "endLine": 271,
                    "content": "def digest_snapshot(snapshot: dict[str, Any]) -> str:     return sha256(         json.dumps(snapshot, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True).encode()     ).hexdigest()"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_core/core/projection/contracts.py:ApprovedProjectionRegistry.resolve#1",
                    "name": "resolve",
                    "filePath": "flowsint-core/src/flowsint_core/core/projection/contracts.py",
                    "nodeType": "Method",
                    "startLine": 234,
                    "endLine": 248,
                    "content": "    def resolve(self, reference: Any | None) -> ProjectionBinding | None:         if reference is None:             return None         profile_id = getattr(reference, \"profile_id\", None)         revision = getattr(reference, \"revision\", None)         profile = self._profiles.get((profile_id, revision))         if profile is None:             raise ProjectionNotApproved()         snapshot = profile.snapshot()         return ProjectionBinding(             profile_id=profile.profile_id,             revision=profile.revision,             digest=digest_snapshot(snapshot),             snapshot=snapshot,         )"
                }
            ]
        },
