            "startLine": 203,
            "endLine": 221,
            "content": "    def _failed_occurrence(         self,         index,         source,         input_ref,         diagnostic=None,         resources=None,         fetch_status=None,     ):         return WebsiteTextOccurrence(             source,             index,             input_ref,             OutcomeStatus.FAILURE,             diagnostic=diagnostic             or self._diagnostic(\"unexpected_error\", \"Unexpected processing failure.\"),             actual_resources=resources,             fetch_status=fetch_status,         )"
