            "content": "    def _cancelled_occurrence(self, index, source, input_ref, resources=None):         return WebsiteTextOccurrence(             source,             index,             input_ref,             OutcomeStatus.HOLD,             diagnostic=self._diagnostic(                 \"cancelled\", \"The operation was cancelled before completion.\"             ),             actual_resources=resources,             fetch_status=FetchStatus.CANCELLED,         )"
        },
        {
            "id": "Method:flowsint-enrichers/src/flowsint_enrichers/website/to_text.py:WebsiteToText._failed_occurrence#6",
