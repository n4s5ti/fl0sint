                    "content": "def _operation_seal(     operation_id, inputs, allocation, policy, parameters, *digests ) -> str:     return _digest(         {             \"operation_id\": operation_id,             \"inputs\": [item.model_dump(mode=\"json\") for item in inputs],             \"allocation\": allocation.model_dump(mode=\"json\", exclude_none=False),             \"policy\": policy.model_dump(mode=\"json\"),             \"parameters\": parameters.model_dump(mode=\"json\"),             \"digests\": digests,         }     )"
