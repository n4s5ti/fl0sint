            "nodeType": "Method",
            "startLine": 349,
            "endLine": 355,
            "content": "    async def charge_request(self, occurrence_id: str) -> bool:         async with self.lock:             if self.requests >= self.request_limit:                 return False             self.requests += 1             self.by_occurrence[occurrence_id][\"requests\"] += 1             return True"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_execution/fetch.py:_Ledger.charge_bytes#3",
            "name": "charge_bytes",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Method",
            "startLine": 357,
            "endLine": 364,
            "content": "    async def charge_bytes(         self, occurrence_id: str, count: int, per_input_limit: int     ) -> bool:         async with self.lock:             occurrence = self.by_occurrence[occurrence_id]             self.bytes += count             occurrence[\"bytes\"] += count             return self.bytes <= self.byte_limit and occurrence[\"bytes\"] <= per_input_limit"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_execution/fetch.py:_Ledger.resources#2",
            "name": "resources",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Method",
            "startLine": 366,
            "endLine": 371,
            "content": "    def resources(self, *, requests=0, bytes_=0) -> Resources:         return Resources(             requests=requests,             bytes=bytes_,             elapsed_seconds=max(0.0, time.monotonic() - self.started),         )"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_execution/fetch.py:_Ledger.occurrence_resources#1",
            "name": "occurrence_resources",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Method",
            "startLine": 373,
            "endLine": 377,
            "content": "    def occurrence_resources(self, occurrence_id: str) -> Resources:         consumed = self.by_occurrence[occurrence_id]         return self.resources(             requests=consumed[\"requests\"], bytes_=consumed[\"bytes\"]         )"
        },
        {
            "id": "Function:flowsint-core/src/flowsint_execution/fetch.py:_origin",
            "name": "_origin",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Function",
            "startLine": 50,
            "endLine": 69,
            "content": "def _origin(url: str) -> str:     parts = urlsplit(url)     if (         parts.scheme not in (\"http\", \"https\")         or not parts.hostname         or parts.username is not None         or parts.password is not None         or any(character.isspace() for character in url)     ):         raise ValueError(\"expected HTTP(S) URL without credentials\")     try:         parsed_port = parts.port         port = parsed_port if parsed_port is not None else (443 if parts.scheme == \"https\" else 80)         if port == 0:             raise ValueError(\"invalid URL port\")     except ValueError as error:         raise ValueError(\"invalid URL port\") from error     host = parts.hostname.lower()     rendered_host = f\"[{host}]\" if \":\" in host else host     return f\"{parts.scheme}://{rendered_host}:{port}\""
        },
        {
            "id": "Function:flowsint-core/src/flowsint_execution/fetch.py:_digest",
            "name": "_digest",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Function",
            "startLine": 80,
            "endLine": 81,
            "content": "def _digest(value: object) -> str:     return hashlib.sha256(_canonical(value)).hexdigest()"
        },
