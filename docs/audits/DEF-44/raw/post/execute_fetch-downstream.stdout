            "startLine": 637,
            "endLine": 641,
            "content": "    async def bounded_cleanup(pending: set[asyncio.Task]) -> None:         cleanup = asyncio.create_task(finish_cleanup(pending))         done, _ = await asyncio.wait({cleanup}, timeout=cleanup_budget)         if not done:             cleanup.add_done_callback(consume_background_result)"
        },
        {
            "id": "Function:flowsint-core/src/flowsint_execution/fetch.py:terminal_outcomes",
            "name": "terminal_outcomes",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Function",
            "startLine": 643,
            "endLine": 666,
            "content": "    def terminal_outcomes(         pending_at_boundary: set[asyncio.Task],         status: FetchStatus,         code: str,         message: str,     ):         outcomes = []         for item, task in zip(operation.inputs, tasks):             if task not in pending_at_boundary:                 outcomes.append(task.result())                 continue             outcomes.append(                 FetchOutcome(                     occurrence_id=item.occurrence_id,                     input_ref=item.input_ref,                     status=status,                     requested_origin=_origin(item.url),                     diagnostic=_diagnostic(                         code, message, retryable=status is FetchStatus.TIMEOUT                     ),                     actual_resources=ledger.occurrence_resources(item.occurrence_id),                 )             )         return outcomes"
        },
        {
            "id": "Function:flowsint-core/src/flowsint_execution/fetch.py:_redacted_location",
            "name": "_redacted_location",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Function",
            "startLine": 862,
            "endLine": 866,
            "content": "def _redacted_location(url: str) -> str:     parts = urlsplit(url)     host = f\"[{parts.hostname}]\" if parts.hostname and \":\" in parts.hostname else parts.hostname     port = f\":{parts.port}\" if parts.port is not None else \"\"     return f\"{parts.scheme}://{host}{port}{parts.path or '/'}\""
        },
        {
            "id": "Function:flowsint-core/src/flowsint_execution/fetch.py:_single_chunk",
            "name": "_single_chunk",
            "filePath": "flowsint-core/src/flowsint_execution/fetch.py",
            "nodeType": "Function",
            "startLine": 869,
            "endLine": 872,
            "content": "async def _single_chunk(content: bytes):     \"\"\"Adapt already-buffered injected transports without changing live streaming.\"\"\"     if content:         yield content"
        }
