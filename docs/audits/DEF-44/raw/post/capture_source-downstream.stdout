                    "content": "    def _dir(fd: int, name: str) -> int:         return os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_execution/artifacts.py:FilesystemArtifactStore._read_bounded#2",
                    "name": "_read_bounded",
                    "filePath": "flowsint-core/src/flowsint_execution/artifacts.py",
                    "nodeType": "Method",
                    "startLine": 184,
                    "endLine": 194,
                    "content": "    def _read_bounded(fd: int, limit: int) -> bytes:         info = os.fstat(fd)         if not stat.S_ISREG(info.st_mode) or info.st_size > limit:             raise OSError(\"unsafe or oversized artifact file\")         chunks, remaining = [], info.st_size         while remaining:             chunk = os.read(fd, min(remaining, 1024 * 1024))             if not chunk: raise OSError(\"short artifact read\")             chunks.append(chunk); remaining -= len(chunk)         if os.read(fd, 1): raise OSError(\"artifact grew during read\")         return b\"\".join(chunks)"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_execution/artifacts.py:FilesystemArtifactStore._write_all#2",
                    "name": "_write_all",
                    "filePath": "flowsint-core/src/flowsint_execution/artifacts.py",
                    "nodeType": "Method",
                    "startLine": 196,
                    "endLine": 201,
                    "content": "    def _write_all(fd: int, data: bytes) -> None:         view = memoryview(data)         while view:             count = os.write(fd, view)             if count <= 0: raise OSError(\"short write\")             view = view[count:]"
                },
                {
                    "id": "Method:flowsint-core/src/flowsint_execution/artifacts.py:FilesystemArtifactStore.write#2",
                    "name": "write",
                    "filePath": "flowsint-core/src/flowsint_execution/artifacts.py",
                    "nodeType": "Method",
                    "startLine": 202,
                    "endLine": 249,
                    "content": "    def write(self, body: bytes, metadata: dict[str, Any]) -> None:         digest, snapshot_id = hashlib.sha256(body).hexdigest(), metadata.get(\"snapshot_id\")         if len(body) > _MAX_ARTIFACT_BYTES or not isinstance(snapshot_id, str) or not re.fullmatch(r\"[a-f0-9]{32}\", snapshot_id):             raise ValueError(\"invalid artifact\")         record_bytes = _canonical(metadata)         if len(record_bytes) > _MAX_METADATA_BYTES: raise ValueError(\"oversized metadata\")         root_fd = self._root_fd()         try:             objects_fd = self._dir(root_fd, \"objects\")             try:                 try: os.mkdir(digest[:2], 0o700, dir_fd=objects_fd)                 except FileExistsError: pass                 prefix_fd = self._dir(objects_fd, digest[:2])                 try:                     name = f\"{digest}.body\"                     temporary = f\".{digest}.{secrets.token_hex(8)}.tmp\"                     object_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=prefix_fd)                     try:                         try:                             self._write_all(object_fd, body); os.fsync(object_fd)                         finally: os.close(object_fd)                         try: os.link(temporary, name, src_dir_fd=prefix_fd, dst_dir_fd=prefix_fd, follow_symlinks=False)                         except FileExistsError:                             object_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=prefix_fd)                             try:                                 if self._read_bounded(object_fd, len(body)) != body: raise OSError(\"artifact collision\")                             finally: os.close(object_fd)                     finally:                         os.unlink(temporary, dir_fd=prefix_fd)                 finally: os.close(prefix_fd)             finally: os.close(objects_fd)             records_fd = self._dir(root_fd, \"records\")             try:                 temporary = f\".{snapshot_id}.{secrets.token_hex(8)}.tmp\"                 fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=records_fd)                 try:                     try: self._write_all(fd, record_bytes); os.fsync(fd)                     finally: os.close(fd)                     os.link(temporary, f\"{snapshot_id}.json\", src_dir_fd=records_fd, dst_dir_fd=records_fd, follow_symlinks=False)                 finally:                     os.unlink(temporary, dir_fd=records_fd)             finally: os.close(records_fd)             fd = os.open(\"lineage.jsonl\", os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600, dir_fd=root_fd)             try:                 fcntl.flock(fd, fcntl.LOCK_EX)                 self._write_all(fd, record_bytes + b\"\\n\")             finally: os.close(fd)         finally: os.close(root_fd)"
                }
            ]
        }
    ],
