                    "content": "    async def test_response_over_policy_limit_is_rejected(self, monkeypatch):         def handler(_request):             return httpx.Response(200, content=b\"x\" * 129)         patch_client(monkeypatch, handler)         enricher = TemplateEnricher(             template=template(),             registry=registry(),             runtime_authorizer=EgressAuthorizer.enrichment(),         )         enricher._graph_service = MagicMock()         result = await enricher.execute_structured([location()])         assert result.outcomes[0].status is OutcomeStatus.FAILURE         assert result.outcomes[0].diagnostic.code == \"connector_response_invalid\""
                },
                {
                    "id": "Method:flowsint-core/tests/templates/test_template_enricher.py:TestRegistryBackedTemplateEnricher.test_total_response_deadline_covers_full_streamed_body#1",
                    "name": "test_total_response_deadline_covers_full_streamed_body",
                    "filePath": "flowsint-core/tests/templates/test_template_enricher.py",
                    "nodeType": "Method",
                    "startLine": 423,
                    "endLine": 455,
                    "content": "    async def test_total_response_deadline_covers_full_streamed_body(self, monkeypatch):         class SlowDripStream(httpx.AsyncByteStream):             async def __aiter__(self):                 payload = (                     b'{\"normalized\":\"untrusted-body-material\",\"city\":\"Test City\",'                     b'\"country\":\"US\",\"zip\":\"00000\"}'                 )                 for chunk in (payload[:40], payload[40:]):                     await asyncio.sleep(0.06)                     yield chunk             async def aclose(self):                 return None         def handler(_request):             return httpx.Response(200, stream=SlowDripStream())         patch_client(monkeypatch, handler)         enricher = TemplateEnricher(             template=template(),             registry=registry(timeout_seconds=0.1),             runtime_authorizer=EgressAuthorizer.enrichment(),         )         enricher._graph_service = MagicMock()         result = await enricher.execute_structured([location()])         outcome = result.outcomes[0]         assert outcome.status is OutcomeStatus.FAILURE         assert outcome.diagnostic is not None         assert outcome.diagnostic.code == \"connector_timeout\"         assert outcome.diagnostic.retryable is True         assert \"untrusted-body-material\" not in result.model_dump_json()"
                },
                {
                    "id": "Method:flowsint-core/tests/templates/test_template_enricher.py:TestRegistryBackedTemplateEnricher.test_secret_and_raw_response_are_not_in_diagnostics_or_logs#1",
