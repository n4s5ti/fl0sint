eturn CaptureResult(ArtifactState.REVIEW, \"source_proof_too_large\")     if cancelled is not None and cancelled(): return CaptureResult(ArtifactState.HOLD, \"capture_cancelled\")     try: store.write(body, metadata)     except (FileNotFoundError, PermissionError): return CaptureResult(ArtifactState.HOLD, \"artifact_store_unavailable\")     except (OSError, ValueError, TypeError): return CaptureResult(ArtifactState.REVIEW, \"artifact_store_invalid\")     if cancelled is not None and cancelled(): return CaptureResult(ArtifactState.HOLD, \"capture_cancelled\")     return CaptureResult(ArtifactState.AVAILABLE, \"retained\", artifact)"
