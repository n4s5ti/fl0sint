                    "endLine": 401,
                    "content": "    async def test_redirect_is_not_followed(self, monkeypatch):         requests = []         def handler(request):             requests.append(request)             return httpx.Response(                 302,                 headers={\"location\": \"https://unapproved.example/redirected\"},             )         patch_client(monkeypatch, handler)         enricher = TemplateEnricher(             template=template(),             registry=registry(),             runtime_authorizer=EgressAuthorizer.enrichment(),         )         enricher._graph_service = MagicMock()         result = await enricher.execute_structured([location()])         assert len(requests) == 1         assert result.outcomes[0].status is OutcomeStatus.FAILURE         assert result.outcomes[0].diagnostic.code == \"connector_response_invalid\"         assert \"unapproved.example\" not in result.model_dump_json()"
