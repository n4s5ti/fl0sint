            "endLine": 459,
            "content": "def _error(exc: ValidationError) -> ContractError:     # Extra keys and JSON object keys are untrusted. Report only known schema names.     names = {         n         for value in globals().values()         if isinstance(value, type) and issubclass(value, BaseModel)         for n in value.model_fields     }     paths = tuple(         \".\".join(             str(p) if isinstance(p, int) or p in names else \"<field>\" for p in e[\"loc\"]         )         or \"$\"         for e in exc.errors(             include_input=False, include_context=False, include_url=False         )     )     return ContractError(\"malformed_contract\", paths)"
