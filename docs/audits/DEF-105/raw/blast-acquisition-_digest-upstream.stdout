        "content": "def _digest(payload: _BundlePayload) -> str:     data = payload.model_dump(mode=\"json\", exclude={\"origin_digest\"}, warnings=\"error\")     return hashlib.sha256(_canonical(data).encode(\"utf-8\")).hexdigest()"
