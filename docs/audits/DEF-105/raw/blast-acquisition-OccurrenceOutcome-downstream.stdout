            "startLine": 327,
            "endLine": 350,
            "content": "class OccurrenceOutcome(_Result):     occurrence_id: Identifier     suboutcomes: tuple[Suboutcome, ...] = ()     @model_validator(mode=\"after\")     def check_partial(self):         if self.status != OutcomeStatus.PARTIAL:             if self.suboutcomes:                 raise ValueError(\"only partial outcomes contain suboutcomes\")             return self         _unique((s.child_id for s in self.suboutcomes), \"child outcome\")         states = [s.status in _SUCCESS for s in self.suboutcomes]         if not any(states) or all(states):             raise ValueError(\"partial requires successful and unsuccessful children\")         children = tuple(c for s in self.suboutcomes for c in s.candidate_ids)         if _unique(children, \"child candidate\") != set(self.candidate_ids):             raise ValueError(                 \"partial candidates must equal successful child candidates\"             )         if set(a for s in self.suboutcomes for a in s.artifact_ids) != set(             self.artifact_ids         ):             raise ValueError(\"partial artifacts must equal successful child artifacts\")         return self"
        },
        {
            "id": "Function:flowsint-core/src/flowsint_execution/acquisition.py:_unique",
            "name": "_unique",
            "filePath": "flowsint-core/src/flowsint_execution/acquisition.py",
            "nodeType": "Function",
            "startLine": 82,
            "endLine": 86,
            "content": "def _unique(values, label):     values = tuple(values)     if len(values) != len(set(values)):         raise ValueError(\"duplicate \" + label)     return set(values)"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_execution/acquisition.py:_Result.check_diagnostic_scalar#1",
            "name": "check_diagnostic_scalar",
            "filePath": "flowsint-core/src/flowsint_execution/acquisition.py",
            "nodeType": "Method",
            "startLine": 267,
            "endLine": 275,
            "content": "    def check_diagnostic_scalar(cls, diagnostic):         if diagnostic is None:             return None         if isinstance(diagnostic, RedactedDiagnostic):             diagnostic = {                 name: getattr(diagnostic, name, None)                 for name in RedactedDiagnostic.model_fields             }         return RedactedDiagnostic.model_validate(diagnostic, strict=True)"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_execution/acquisition.py:_Result.check_status#0",
            "name": "check_status",
            "filePath": "flowsint-core/src/flowsint_execution/acquisition.py",
            "nodeType": "Method",
            "startLine": 278,
            "endLine": 314,
            "content": "    def check_status(self):         _unique(self.candidate_ids, \"candidate reference\")         _unique(self.artifact_ids, \"artifact reference\")         if self.status in _SUCCESS:             if self.diagnostic is not None or self.completion_witness is None:                 raise ValueError(                     \"successful acquisition requires completion witness and no diagnostic\"                 )             if bool(self.candidate_ids) != (                 self.status == OutcomeStatus.SUCCESS_WITH_OUTPUT             ):                 raise ValueError(\"success status disagrees with candidate cardinality\")             expected = CanonicalOutcomeStatus.SUCCESS         elif self.status == OutcomeStatus.PARTIAL:             if self.diagnostic is None or self.completion_witness is not None:                 raise ValueError(                     \"partial requires diagnostic and per-child completion witnesses\"                 )             expected = None         else:             if (                 self.diagnostic is None                 or self.candidate_ids                 or self.artifact_ids                 or self.completion_witness is not None             ):                 raise ValueError(                     \"failure/unknown/hold requires diagnostic and cannot carry material or completion\"                 )             expected = (                 CanonicalOutcomeStatus.HOLD                 if self.status == OutcomeStatus.RETENTION_HOLD                 else CanonicalOutcomeStatus.FAILURE if self.status in _FAILURE else None             )         if expected is not None and self.underlying_status not in (None, expected):             raise ValueError(\"granular status contradicts underlying status\")         return self"
        },
        {
            "id": "Method:flowsint-core/src/flowsint_execution/acquisition.py:OccurrenceOutcome.check_partial#0",
            "name": "check_partial",
            "filePath": "flowsint-core/src/flowsint_execution/acquisition.py",
            "nodeType": "Method",
            "startLine": 332,
            "endLine": 350,
            "content": "    def check_partial(self):         if self.status != OutcomeStatus.PARTIAL:             if self.suboutcomes:                 raise ValueError(\"only partial outcomes contain suboutcomes\")             return self         _unique((s.child_id for s in self.suboutcomes), \"child outcome\")         states = [s.status in _SUCCESS for s in self.suboutcomes]         if not any(states) or all(states):             raise ValueError(\"partial requires successful and unsuccessful children\")         children = tuple(c for s in self.suboutcomes for c in s.candidate_ids)         if _unique(children, \"child candidate\") != set(self.candidate_ids):             raise ValueError(                 \"partial candidates must equal successful child candidates\"             )         if set(a for s in self.suboutcomes for a in s.artifact_ids) != set(             self.artifact_ids         ):             raise ValueError(\"partial artifacts must equal successful child artifacts\")         return self"
        },
        {
