                    "nodeType": "Method",
                    "startLine": 57,
                    "endLine": 62,
                    "content": "    def normalize_timestamp(cls, value: datetime | None) -> datetime | None:         if value is None:             return None         if value.tzinfo is None or value.utcoffset() is None:             raise ValueError(\"evidence timestamps must be timezone-aware\")         return value.astimezone(timezone.utc)"
