        "endLine": 239,
        "content": "    def aggregate_status(outcomes: tuple[InputOutcome, ...]) -> str:         statuses = {outcome.status for outcome in outcomes}         if not outcomes or statuses == {OutcomeStatus.SUCCESS}:             return \"completed\"         if OutcomeStatus.SUCCESS in statuses:             return \"partial\"         if OutcomeStatus.HOLD in statuses:             return \"hold\"         return \"failed\""
