                    "content": "def connector_template_digest(template: object) -> str:     \"\"\"Hash strict template content for worker replay without retaining it.\"\"\"     content = template.model_dump(mode=\"json\")     serialized = json.dumps(         content, ensure_ascii=False, separators=(\",\", \":\"), sort_keys=True     )     return hashlib.sha256(serialized.encode(\"utf-8\")).hexdigest()"
